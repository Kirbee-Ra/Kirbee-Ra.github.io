%% ============================================================
%  Figure 7: Full-time LPF + extrema + demodulation result
% ============================================================

fig7 = figure(7);
clf(fig7);
set(fig7, 'Color', 'w');

tl7 = tiledlayout(fig7, 3, 1, ...
    'TileSpacing', 'compact', ...
    'Padding', 'compact');

%% Fig. 7-1: LPF + extrema + manual timing
ax7_0 = nexttile(tl7, 1);
hold(ax7_0, 'on');

for k = 1:size(y_win, 2)

    envelope_lpf = envelopeResult(k).envelope_lpf;
    tLpfExtrema = envelopeResult(k).tLpfExtrema;
    pksLpfExtrema = envelopeResult(k).pksLpfExtrema;
