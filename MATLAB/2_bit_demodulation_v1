%% ============================================================
%  Local function: append demodulation state
% ============================================================

function [tState, S1State, S0State] = appendState( ...
    tState, S1State, S0State, tNew, S1New, S0New)

    if isempty(tState)

        tState = tNew;
        S1State = S1New;
        S0State = S0New;
        return;

    end

    if tNew < tState(end)
        return;
    end

    if abs(tNew - tState(end)) < eps

        S1State(end) = S1New;
        S0State(end) = S0New;

    else

        tState = [tState; tNew];
        S1State = [S1State; S1New];
        S0State = [S0State; S0New];

    end

end
