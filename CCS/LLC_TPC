//###########################################################################
//
// File: TPC_Demod_32k_Final.c
// Target: TMS320F28379D
//
// ADC sampling : 32 kHz using ePWM6 SOCA
// ADC input    : ADCINA0
//
// Debug GPIO outputs:
//   GPIO24 -> S0
//   GPIO25 -> S1
//   GPIO26 -> peak_detected, stretched pulse
//
// CCS Watch variables:
//   fmod
//   S0
//   S1
//   peak_detected
//   peak_sign
//   adcRaw
//   adcVolt
//   demodInput
//   sample_count
//   demod_state
//
//###########################################################################

#include "F28x_Project.h"

//==============================================================
// User parameters
//==============================================================

#define SYSCLK_HZ                   200000000UL
#define EPWMCLK_HZ                  100000000UL

#define ADC_FS_HZ                   32000UL
#define ADC_TBPRD                   ((EPWMCLK_HZ / ADC_FS_HZ) - 1U)

// ADCINA0 = 0
#define ADC_CH                      0U

#define ADC_MAX_COUNT               4095.0f
#define ADC_VREF                    3.3f

/*
 * ADC input signal is assumed to be biased at 1.65 V.
 * demodInput = adcVolt - ADC_MID_VOLT
 */
#define ADC_MID_VOLT                1.65f

/*
 * Peak detection threshold.
 * If peak is missed, reduce this.
 * If noise causes false peak, increase this.
 */
#define PEAK_TH                     0.001f

/*
 * Peak lockout to prevent duplicate detection around flat peak.
 * 3 samples at 32 kHz = 93.75 us.
 */
#define PEAK_LOCKOUT_SAMPLES        3

/*
 * Peak pulse stretching for oscilloscope.
 * 5 samples at 32 kHz = 156.25 us.
 */
#define PEAK_GPIO_HOLD_SAMPLES      5

/*
 * Demod intervals.
 *
 * S1 = 1 nominal full interval = 20 samples
 * S1 = 0 nominal full interval = 40 samples
 *
 * Modified short decision:
 *   dt <= 22 samples -> S1 = 1
 *   dt >  22 samples -> S1 = 0
 */
#define INTERVAL_SHORT              20
#define INTERVAL_SHORT_MAX          22
#define INTERVAL_LONG               40

/*
 * Half interval tolerance.
 * S1=1 -> half interval = 10 samples
 * S1=0 -> half interval = 20 samples
 */
#define SAMPLE_TOL                  1

//==============================================================
// Demod states
//==============================================================

#define ST_WAIT_FIRST_PEAK          0
#define ST_WAIT_SECOND_PEAK         1
#define ST_WAIT_HALF_PEAK           2
#define ST_WAIT_NEXT_PEAK           3

//==============================================================
// Global variables for CCS Watch
//==============================================================

volatile Uint16 fmod = 0;               // 0: demod off, nonzero: demod on

volatile Uint16 S0 = 0;
volatile Uint16 S1 = 0;

volatile Uint16 peak_detected = 0;
volatile int16  peak_sign = 0;          // +1: positive peak, -1: negative peak

volatile Uint16 adcRaw = 0;
volatile float  adcVolt = 0.0f;
volatile float  demodInput = 0.0f;

volatile Uint32 sample_count = 0;

volatile int32 peak_sample = 0;
volatile int32 last_peak_sample = 0;
volatile int32 ref_peak_sample = 0;
volatile int16 last_peak_sign = 0;

volatile Uint16 demod_state = ST_WAIT_FIRST_PEAK;

volatile Uint16 peak_gpio_hold_count = 0;

//==============================================================
// Internal static variables
//==============================================================

static float x_nm2 = 0.0f;       // x[n-2]
static float x_nm1 = 0.0f;       // x[n-1]
static float x_n   = 0.0f;       // x[n]

static int32 last_detected_peak_sample = -1000000;

static Uint16 demod_enabled_prev = 0;

//==============================================================
// Function prototypes
//==============================================================

void Init_ADCA_A0(void);
void Init_ADC_32k_EPWM6(void);
void Init_Debug_GPIO(void);

void Reset_Demod(void);
void Update_Peak_Detector(float x);
void Update_Demod_Logic(void);
void Update_Debug_GPIO(void);

interrupt void adca1_isr(void);

//==============================================================
// Main
//==============================================================

void main(void)
{
    InitSysCtrl();

    DINT;

    InitPieCtrl();

    IER = 0x0000;
    IFR = 0x0000;

    InitPieVectTable();

    EALLOW;
    PieVectTable.ADCA1_INT = &adca1_isr;
    EDIS;

    InitGpio();

    Init_Debug_GPIO();
    Init_ADCA_A0();
    Init_ADC_32k_EPWM6();

    PieCtrlRegs.PIEIER1.bit.INTx1 = 1;
    IER |= M_INT1;

    EINT;
    ERTM;

    while(1)
    {
        /*
         * CCS Expressions window에서 fmod를 조작.
         *
         * fmod = 0 -> demod reset
         * fmod = 1 -> demod start
         */
    }
}

//==============================================================
// Debug GPIO setup
//==============================================================

void Init_Debug_GPIO(void)
{
    EALLOW;

    /*
     * GPIO24 = S0
     * GPIO25 = S1
     * GPIO26 = peak_detected, stretched pulse
     */

    GpioCtrlRegs.GPAMUX2.bit.GPIO24 = 0;
    GpioCtrlRegs.GPADIR.bit.GPIO24  = 1;
    GpioCtrlRegs.GPAPUD.bit.GPIO24  = 0;

    GpioCtrlRegs.GPAMUX2.bit.GPIO25 = 0;
    GpioCtrlRegs.GPADIR.bit.GPIO25  = 1;
    GpioCtrlRegs.GPAPUD.bit.GPIO25  = 0;

    GpioCtrlRegs.GPAMUX2.bit.GPIO26 = 0;
    GpioCtrlRegs.GPADIR.bit.GPIO26  = 1;
    GpioCtrlRegs.GPAPUD.bit.GPIO26  = 0;

    GpioDataRegs.GPACLEAR.bit.GPIO24 = 1;
    GpioDataRegs.GPACLEAR.bit.GPIO25 = 1;
    GpioDataRegs.GPACLEAR.bit.GPIO26 = 1;

    EDIS;
}

//==============================================================
// Reset demodulator
//==============================================================

void Reset_Demod(void)
{
    S0 = 0;
    S1 = 0;

    peak_detected = 0;
    peak_sign = 0;

    adcRaw = 0;
    adcVolt = 0.0f;
    demodInput = 0.0f;

    sample_count = 0;

    peak_sample = 0;
    last_peak_sample = 0;
    ref_peak_sample = 0;
    last_peak_sign = 0;

    demod_state = ST_WAIT_FIRST_PEAK;

    x_nm2 = 0.0f;
    x_nm1 = 0.0f;
    x_n   = 0.0f;

    last_detected_peak_sample = -1000000;

    peak_gpio_hold_count = 0;

    GpioDataRegs.GPACLEAR.bit.GPIO24 = 1;
    GpioDataRegs.GPACLEAR.bit.GPIO25 = 1;
    GpioDataRegs.GPACLEAR.bit.GPIO26 = 1;
}

//==============================================================
// Peak detector
//
// Relaxed 3-point comparison:
//
// Positive peak:
//   Case 1: x[n-2] <  x[n-1] and x[n] <= x[n-1]
//   Case 2: x[n-2] <= x[n-1] and x[n] <  x[n-1]
//
// Negative peak:
//   Case 1: x[n-2] >  x[n-1] and x[n] >= x[n-1]
//   Case 2: x[n-2] >= x[n-1] and x[n] >  x[n-1]
//
// peak_sample = sample_count - 1
//
//==============================================================

void Update_Peak_Detector(float x)
{
    int32 lockout_dt;

    peak_detected = 0;
    peak_sign = 0;

    x_nm2 = x_nm1;
    x_nm1 = x_n;
    x_n   = x;

    if(sample_count < 2U)
    {
        return;
    }

    /*
     * Positive peak detection
     */
    if( ((((x_nm2 < x_nm1)  && (x_n <= x_nm1)) ||
          ((x_nm2 <= x_nm1) && (x_n <  x_nm1))) &&
          (x_nm1 > PEAK_TH)) )
    {
        peak_detected = 1U;
        peak_sign = 1;
        peak_sample = (int32)sample_count - 1;
    }

    /*
     * Negative peak detection
     */
    else if( ((((x_nm2 > x_nm1)  && (x_n >= x_nm1)) ||
               ((x_nm2 >= x_nm1) && (x_n >  x_nm1))) &&
               (x_nm1 < -PEAK_TH)) )
    {
        peak_detected = 1U;
        peak_sign = -1;
        peak_sample = (int32)sample_count - 1;
    }

    /*
     * Lockout
     */
    if(peak_detected)
    {
        lockout_dt = peak_sample - last_detected_peak_sample;

        if(lockout_dt < PEAK_LOCKOUT_SAMPLES)
        {
            peak_detected = 0U;
            peak_sign = 0;
        }
        else
        {
            last_detected_peak_sample = peak_sample;
        }
    }
}

//==============================================================
// Demodulation logic
//
// Requested logic:
//
// 1. fmod != 0이면 복조 시작
// 2. 첫 peak 감지 후, 두 번째 peak가 22 sample 이하이면 S1=1,
//    아니면 S1=0
// 3. 첫 peak가 음수면 S0=1, 양수면 S0=0
// 4. peak가 감지될 때마다 정보 업데이트
// 5. 현재 S1 값에 해당하는 peak interval의 half 위치에서
//    peak가 검출되면 S0 변화
// 6. 직전 peak 양수면 S0=1로 변화
// 7. 직전 peak 음수면 S0=0으로 변화
// 8. 이후 22 sample 이하에서 peak가 또 감지되면 S1=1,
//    아니면 S1=0
//
// Delay accumulation prevention:
//   detection window allows dt <= 22,
//   but reference timing is updated by nominal interval.
//
//==============================================================

void Update_Demod_Logic(void)
{
    int32 dt;
    int32 abs_err;
    int32 target_half;

    switch(demod_state)
    {
        //======================================================
        // 1. Wait first peak
        //======================================================
        case ST_WAIT_FIRST_PEAK:

            if(peak_detected)
            {
                if(peak_sign < 0)
                {
                    S0 = 1U;
                }
                else
                {
                    S0 = 0U;
                }

                S1 = 0U;

                ref_peak_sample = peak_sample;
                last_peak_sample = peak_sample;
                last_peak_sign = peak_sign;

                demod_state = ST_WAIT_SECOND_PEAK;
            }

            break;

        //======================================================
        // 2. Wait second peak
        //
        // second peak within 22 samples -> S1 = 1
        // otherwise                     -> S1 = 0
        //======================================================
        case ST_WAIT_SECOND_PEAK:

            if(peak_detected)
            {
                dt = peak_sample - last_peak_sample;

                if(dt <= INTERVAL_SHORT_MAX)
                {
                    S1 = 1U;

                    /*
                     * nominal timing update to avoid accumulated delay
                     */
                    ref_peak_sample = last_peak_sample + INTERVAL_SHORT;
                }
                else
                {
                    S1 = 0U;

                    /*
                     * nominal long interval update
                     */
                    ref_peak_sample = last_peak_sample + INTERVAL_LONG;
                }

                last_peak_sample = peak_sample;
                last_peak_sign = peak_sign;

                demod_state = ST_WAIT_HALF_PEAK;
            }

            break;

        //======================================================
        // 3. Wait half interval peak
        //
        // S1 = 1 -> full 20, half 10
        // S1 = 0 -> full 40, half 20
        //======================================================
        case ST_WAIT_HALF_PEAK:

            if(S1 == 1U)
            {
                target_half = INTERVAL_SHORT / 2;    // 10
            }
            else
            {
                target_half = INTERVAL_LONG / 2;     // 20
            }

            if(peak_detected)
            {
                dt = peak_sample - ref_peak_sample;

                abs_err = dt - target_half;
                if(abs_err < 0)
                {
                    abs_err = -abs_err;
                }

                if(abs_err <= SAMPLE_TOL)
                {
                    /*
                     * S0 change according to previous peak sign.
                     *
                     * previous positive -> old S0=0 -> new S0=1
                     * previous negative -> old S0=1 -> new S0=0
                     */
                    if(last_peak_sign > 0)
                    {
                        S0 = 1U;
                    }
                    else if(last_peak_sign < 0)
                    {
                        S0 = 0U;
                    }

                    /*
                     * nominal half interval update
                     */
                    ref_peak_sample = ref_peak_sample + target_half;

                    last_peak_sample = peak_sample;
                    last_peak_sign = peak_sign;

                    demod_state = ST_WAIT_NEXT_PEAK;
                }
                else
                {
                    /*
                     * Unexpected peak.
                     * Use current peak as recovery reference.
                     *
                     * If false peak is severe in experiment,
                     * this block can be changed to ignore unexpected peaks.
                     */
                    ref_peak_sample = peak_sample;
                    last_peak_sample = peak_sample;
                    last_peak_sign = peak_sign;
                }
            }

            break;

        //======================================================
        // 4. After S0 change
        //
        // next peak within 22 samples -> S1 = 1
        // no peak until 22 samples    -> S1 = 0
        //======================================================
        case ST_WAIT_NEXT_PEAK:

            if(peak_detected)
            {
                dt = peak_sample - ref_peak_sample;

                if(dt <= INTERVAL_SHORT_MAX)
                {
                    S1 = 1U;

                    /*
                     * nominal 20 sample update
                     */
                    ref_peak_sample = ref_peak_sample + INTERVAL_SHORT;
                }
                else
                {
                    S1 = 0U;

                    /*
                     * nominal 40 sample update
                     */
                    ref_peak_sample = ref_peak_sample + INTERVAL_LONG;
                }

                last_peak_sample = peak_sample;
                last_peak_sign = peak_sign;

                demod_state = ST_WAIT_HALF_PEAK;
            }
            else
            {
                dt = (int32)sample_count - ref_peak_sample;

                if(dt > INTERVAL_SHORT_MAX)
                {
                    S1 = 0U;
                }
            }

            break;

        default:

            demod_state = ST_WAIT_FIRST_PEAK;

            break;
    }
}

//==============================================================
// Debug GPIO update
//==============================================================

void Update_Debug_GPIO(void)
{
    /*
     * peak_detected pulse stretching
     */
    if(peak_detected)
    {
        peak_gpio_hold_count = PEAK_GPIO_HOLD_SAMPLES;
    }
    else
    {
        if(peak_gpio_hold_count > 0U)
        {
            peak_gpio_hold_count--;
        }
    }

    /*
     * GPIO24 = S0
     */
    if(S0)
    {
        GpioDataRegs.GPASET.bit.GPIO24 = 1;
    }
    else
    {
        GpioDataRegs.GPACLEAR.bit.GPIO24 = 1;
    }

    /*
     * GPIO25 = S1
     */
    if(S1)
    {
        GpioDataRegs.GPASET.bit.GPIO25 = 1;
    }
    else
    {
        GpioDataRegs.GPACLEAR.bit.GPIO25 = 1;
    }

    /*
     * GPIO26 = stretched peak_detected
     */
    if(peak_gpio_hold_count > 0U)
    {
        GpioDataRegs.GPASET.bit.GPIO26 = 1;
    }
    else
    {
        GpioDataRegs.GPACLEAR.bit.GPIO26 = 1;
    }
}

//==============================================================
// ADC ISR
//==============================================================

interrupt void adca1_isr(void)
{
    Uint16 raw;
    float v_adc;
    float x;

    raw = AdcaResultRegs.ADCRESULT0;

    adcRaw = raw;

    v_adc = ((float)raw / ADC_MAX_COUNT) * ADC_VREF;
    adcVolt = v_adc;

    /*
     * Remove ADC offset.
     * Signal must be centered around ADC_MID_VOLT.
     */
    x = v_adc - ADC_MID_VOLT;
    demodInput = x;

    /*
     * fmod == 0 -> reset
     */
    if(fmod == 0U)
    {
        Reset_Demod();
        demod_enabled_prev = 0U;
    }
    else
    {
        /*
         * fmod rising edge: initialize demod samples with present value
         */
        if(demod_enabled_prev == 0U)
        {
            Reset_Demod();

            x_nm2 = x;
            x_nm1 = x;
            x_n   = x;

            demod_enabled_prev = 1U;
        }

        Update_Peak_Detector(x);
        Update_Demod_Logic();
        Update_Debug_GPIO();

        sample_count++;
    }

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    if(AdcaRegs.ADCINTOVF.bit.ADCINT1 == 1)
    {
        AdcaRegs.ADCINTOVFCLR.bit.ADCINT1 = 1;
        AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;
    }

    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

//==============================================================
// ADCA setup
//==============================================================

void Init_ADCA_A0(void)
{
    EALLOW;

    /*
     * ADC clock prescale.
     * PRESCALE = 6 -> ADCCLK = SYSCLK / 4 on F28379D examples.
     */
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;

    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;

    DELAY_US(1000);

    /*
     * ADCA SOC0
     * CHSEL   = ADCINA0
     * TRIGSEL = ePWM6 SOCA
     * ACQPS   = 63
     */
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_CH;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = 63;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 15;

    /*
     * ADCINT1 triggered by EOC0
     */
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

//==============================================================
// ePWM6 SOCA setup for 32 kHz ADC trigger
//==============================================================

void Init_ADC_32k_EPWM6(void)
{
    EALLOW;

    CpuSysRegs.PCLKCR2.bit.EPWM6 = 1;

    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 0;

    EPwm6Regs.TBCTL.bit.CTRMODE = TB_COUNT_UP;
    EPwm6Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm6Regs.TBCTL.bit.SYNCOSEL = TB_SYNC_DISABLE;

    EPwm6Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm6Regs.TBCTL.bit.CLKDIV = TB_DIV1;

    EPwm6Regs.TBPRD = ADC_TBPRD;
    EPwm6Regs.TBCTR = 0;

    /*
     * Generate SOCA at counter zero.
     */
    EPwm6Regs.ETSEL.bit.SOCAEN = 1;
    EPwm6Regs.ETSEL.bit.SOCASEL = ET_CTR_ZERO;
    EPwm6Regs.ETPS.bit.SOCAPRD = ET_1ST;

    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;

    EDIS;
}
