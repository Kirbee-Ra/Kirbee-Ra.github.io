// ============================================================
// F28379xD EPWM1A/B Soft Start with SW Variable Enable
// + Frequency Modulation after Soft Start
// + ADC sensing
// + 1st-order IIR LPF
// + DAC monitor output
//
// SW = 1 : Soft start run
// SW = 0 : PWM force off, soft-start reset
//
// EPWM1A : GPIO0
// EPWM1B : GPIO1
//
// DACA : switching frequency command monitor
// DACB : filtered ADC voltage monitor
//
// ADC input : ADCINA2
//
// Soft-start profile:
// 0.0 ~ 0.5 s : fs = 200 kHz, duty 0 -> 0.5
// 0.5 ~ 1.0 s : duty = 0.5, fs 200 kHz -> 100 kHz
// 1.0 s 이후  : duty = 0.5, fs_base = 100 kHz
//
// Frequency modulation after soft start only:
// fmod = 0 : no modulation
// fmod = 1 : 400 Hz triangular, phase 90 deg
// fmod = 2 : 400 Hz triangular, phase 270 deg
// fmod = 3 : 800 Hz triangular, phase 90 deg
// fmod = 4 : 800 Hz triangular, phase 270 deg
// fmod = 5 : every 1/400 s, mode changes 1 -> 2 -> 3 -> 4
//
// Frequency deviation:
// peak-to-peak = 20 kHz
// amplitude    = ±10 kHz
//
// Assumption:
// SYSCLK = 200 MHz
// EPWMCLK = 100 MHz
// TBCLK = 100 MHz
// Up-down count mode
// ============================================================

#include "F28x_Project.h"

// ---------------- User parameters ----------------
#define SYSCLK_HZ              200000000UL
#define EPWM_TBCLK_HZ          100000000UL

#define FS_START_HZ            200000.0f
#define FS_END_HZ              100000.0f

#define DUTY_MAX               0.5f

#define DUTY_RAMP_TIME_S       0.5f
#define FREQ_RAMP_TIME_S       0.5f
#define TOTAL_SS_TIME_S        1.0f

#define DEADTIME_S             100e-9f

// Frequency modulation
#define FMOD_DEV_HZ            10000.0f
#define FMOD_400_HZ            400.0f
#define FMOD_800_HZ            800.0f

#define PHASE_90_CYCLE         0.25f
#define PHASE_270_CYCLE        0.75f

#define FMOD_SEQUENCE_FREQ_HZ   400.0f
#define FMOD_SEQUENCE_PERIOD_S  (1.0f / FMOD_SEQUENCE_FREQ_HZ)

// Soft-start update period
#define UPDATE_PERIOD_US        10.0f
#define UPDATE_PERIOD_S         (UPDATE_PERIOD_US * 1e-6f)

// ---------------- ADC / DAC monitor parameters ----------------
#define ADC_VREF_V              3.3f
#define ADC_MAX_CODE            4095.0f
#define ADC_INPUT_CH            2U          // ADCINA2
#define ADC_ACQPS               14U

// ADC LPF cutoff frequency
#define ADC_LPF_FC_HZ           2000.0f
#define TWO_PI                  6.28318530718f

// DACA scaling for fs_cmd monitor
// DACA = 0 V   -> 50 kHz
// DACA = 3.3 V -> 250 kHz
#define FS_DAC_MIN_HZ           50000.0f
#define FS_DAC_MAX_HZ           250000.0f

// DAC full scale
#define DAC_MAX_CODE            4095.0f

// ---------------- Global variables ----------------
volatile float ss_time = 0.0f;
volatile float run_time = 0.0f;
volatile Uint16 pwm_enabled = 0;

// CCS Expressions 창에서 SW 값을 변경
// SW = 0 : PWM off + soft-start reset
// SW = 1 : soft-start run
volatile Uint16 SW = 0;

// CCS Expressions 창에서 fmod 값을 변경
volatile Uint16 fmod = 0;

// Monitoring variables
volatile float fs_base_mon = 0.0f;
volatile float fs_cmd_mon = 0.0f;
volatile float duty_mon = 0.0f;

// ADC monitoring variables
volatile Uint16 adcRaw = 0;
volatile float  V_ADC_RAW = 0.0f;
volatile float  V_ADC_FILT = 0.0f;

// ---------------- Function prototypes ----------------
void InitEPwm1SoftStart(void);
void InitCpuTimer0ForSoftStart(void);
void InitADC_A(void);
void InitDACMonitor(void);

void UpdateEPwm1(float fs, float duty);
void ForceEPwm1Off(void);
void ReleaseEPwm1Trip(void);

void UpdateADCAndDACMonitor(float fs_cmd);

Uint16 FloatToDacCode(float x, float xmin, float xmax);

float Mod1(float x);
float TriangleWaveNorm(float phase);
float ApplyFrequencyModulation(float fs_base, float time_s);

__interrupt void cpu_timer0_isr(void);

// ============================================================
// main
// ============================================================
void main(void)
{
    InitSysCtrl();

    DINT;

    InitPieCtrl();

    IER = 0x0000;
    IFR = 0x0000;

    InitPieVectTable();

    EALLOW;
    PieVectTable.TIMER0_INT = &cpu_timer0_isr;
    EDIS;

    InitGpio();

    // ---------------- GPIO0 / GPIO1 : EPWM1A / EPWM1B ----------------
    GPIO_SetupPinMux(0, GPIO_MUX_CPU1, 1);   // GPIO0 = EPWM1A
    GPIO_SetupPinMux(1, GPIO_MUX_CPU1, 1);   // GPIO1 = EPWM1B

    // ADC / DAC init
    InitADC_A();
    InitDACMonitor();

    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 0;
    EDIS;

    InitEPwm1SoftStart();

    EALLOW;
    CpuSysRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;

    InitCpuTimer0ForSoftStart();

    // Enable CPU Timer0 interrupt
    IER |= M_INT1;
    PieCtrlRegs.PIEIER1.bit.INTx7 = 1;

    EINT;
    ERTM;

    // 초기 상태: PWM off
    ForceEPwm1Off();

    while(1)
    {
        // main loop에서는 별도 동작 없음
        // SW, fmod 값은 CCS Expressions 창에서 변경 가능
        // soft-start, 주파수 변조, ADC/DAC monitor는 Timer0 ISR에서 수행
    }
}

// ============================================================
// ADC-A initialization
// ADCINA2 -> ADCA SOC0
// ============================================================
void InitADC_A(void)
{
    EALLOW;

    // ADC clock prescale
    // ADCCLK = SYSCLK / 4 정도로 설정
    AdcaRegs.ADCCTL2.bit.PRESCALE = 6;

    // 12-bit single-ended mode
    AdcSetMode(ADC_ADCA, ADC_RESOLUTION_12BIT, ADC_SIGNALMODE_SINGLE);

    // Interrupt pulse at end of conversion
    AdcaRegs.ADCCTL1.bit.INTPULSEPOS = 1;

    // Power up ADC
    AdcaRegs.ADCCTL1.bit.ADCPWDNZ = 1;

    EDIS;

    DELAY_US(1000);

    EALLOW;

    // SOC0: ADCINA2, software trigger
    AdcaRegs.ADCSOC0CTL.bit.CHSEL = ADC_INPUT_CH;
    AdcaRegs.ADCSOC0CTL.bit.ACQPS = ADC_ACQPS;
    AdcaRegs.ADCSOC0CTL.bit.TRIGSEL = 0;     // software trigger only

    // ADCINT1 generated after EOC0
    AdcaRegs.ADCINTSEL1N2.bit.INT1SEL = 0;   // EOC0
    AdcaRegs.ADCINTSEL1N2.bit.INT1E = 1;
    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    EDIS;
}

// ============================================================
// DAC monitor initialization
// DACA : fs_cmd monitor
// DACB : filtered ADC voltage monitor
// ============================================================
void InitDACMonitor(void)
{
    EALLOW;

    // Enable DAC clocks
    CpuSysRegs.PCLKCR16.bit.DAC_A = 1;
    CpuSysRegs.PCLKCR16.bit.DAC_B = 1;

    // Use ADC VREFHI as DAC reference
    DacaRegs.DACCTL.bit.DACREFSEL = 1;
    DacbRegs.DACCTL.bit.DACREFSEL = 1;

    // Enable DAC outputs
    DacaRegs.DACOUTEN.bit.DACOUTEN = 1;
    DacbRegs.DACOUTEN.bit.DACOUTEN = 1;

    // Initial output = 0 V
    DacaRegs.DACVALS.all = 0;
    DacbRegs.DACVALS.all = 0;

    EDIS;

    DELAY_US(10);
}

// ============================================================
// EPWM1 initialization
// ============================================================
void InitEPwm1SoftStart(void)
{
    Uint16 tbprd_200k;
    Uint16 deadtime_count;

    tbprd_200k = (Uint16)((float)EPWM_TBCLK_HZ / (2.0f * FS_START_HZ));
    deadtime_count = (Uint16)((float)EPWM_TBCLK_HZ * DEADTIME_S);

    EALLOW;

    // ---------------- Time-base ----------------
    EPwm1Regs.TBCTL.bit.CTRMODE = TB_COUNT_UPDOWN;
    EPwm1Regs.TBCTL.bit.PHSEN = TB_DISABLE;
    EPwm1Regs.TBCTL.bit.SYNCOSEL = TB_SYNC_DISABLE;
    EPwm1Regs.TBCTL.bit.HSPCLKDIV = TB_DIV1;
    EPwm1Regs.TBCTL.bit.CLKDIV = TB_DIV1;

    EPwm1Regs.TBPRD = tbprd_200k;
    EPwm1Regs.TBCTR = 0;

    // ---------------- Compare ----------------
    EPwm1Regs.CMPA.bit.CMPA = 0;

    EPwm1Regs.CMPCTL.bit.SHDWAMODE = CC_SHADOW;
    EPwm1Regs.CMPCTL.bit.LOADAMODE = CC_CTR_ZERO;

    // ---------------- Action qualifier ----------------
    // Up-down count 기준:
    // duty = CMPA / TBPRD
    EPwm1Regs.AQCTLA.bit.ZRO = AQ_SET;
    EPwm1Regs.AQCTLA.bit.CAU = AQ_CLEAR;
    EPwm1Regs.AQCTLA.bit.CAD = AQ_SET;

    // EPWM1B는 Dead-band module에서 생성
    EPwm1Regs.AQCTLB.all = 0;

    // ---------------- Dead-band ----------------
    // EPWM1A/B complementary output
    EPwm1Regs.DBCTL.bit.OUT_MODE = DB_FULL_ENABLE;
    EPwm1Regs.DBCTL.bit.IN_MODE = DBA_ALL;
    EPwm1Regs.DBCTL.bit.POLSEL = DB_ACTV_HIC;

    EPwm1Regs.DBRED.bit.DBRED = deadtime_count;
    EPwm1Regs.DBFED.bit.DBFED = deadtime_count;

    // ---------------- Trip-zone ----------------
    // Trip 발생 시 EPWM1A/B 모두 Low
    EPwm1Regs.TZCTL.bit.TZA = TZ_FORCE_LO;
    EPwm1Regs.TZCTL.bit.TZB = TZ_FORCE_LO;

    // 초기에는 강제 off
    EPwm1Regs.TZFRC.bit.OST = 1;

    EDIS;
}

// ============================================================
// CPU Timer0 initialization
// ============================================================
void InitCpuTimer0ForSoftStart(void)
{
    InitCpuTimers();

    // CPU Timer0 period = UPDATE_PERIOD_US
    ConfigCpuTimer(&CpuTimer0, 200, UPDATE_PERIOD_US);

    CpuTimer0Regs.TCR.bit.TSS = 0;   // Start timer
}

// ============================================================
// Timer0 ISR
// ============================================================
__interrupt void cpu_timer0_isr(void)
{
    float fs_base;
    float fs_cmd;
    float duty;
    float t2;

    // ========================================================
    // SW = 0 : PWM 강제 종료 + soft-start reset
    // ========================================================
    if(SW == 0)
    {
        ss_time = 0.0f;
        run_time = 0.0f;
        pwm_enabled = 0;

        fs_base_mon = 0.0f;
        fs_cmd_mon = 0.0f;
        duty_mon = 0.0f;

        // ADC/DAC monitor도 0으로 초기화
        V_ADC_RAW = 0.0f;
        V_ADC_FILT = 0.0f;
        DacaRegs.DACVALS.all = 0;
        DacbRegs.DACVALS.all = 0;

        ForceEPwm1Off();

        PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
        return;
    }

    // ========================================================
    // SW = 1 : soft-start 진행
    // ========================================================
    pwm_enabled = 1;

    // ---------------- Soft-start base profile ----------------
    if(ss_time < DUTY_RAMP_TIME_S)
    {
        fs_base = FS_START_HZ;
        duty = DUTY_MAX * (ss_time / DUTY_RAMP_TIME_S);
    }
    else if(ss_time < TOTAL_SS_TIME_S)
    {
        t2 = ss_time - DUTY_RAMP_TIME_S;

        duty = DUTY_MAX;
        fs_base = FS_START_HZ - (FS_START_HZ - FS_END_HZ)
                  * (t2 / FREQ_RAMP_TIME_S);
    }
    else
    {
        fs_base = FS_END_HZ;
        duty = DUTY_MAX;
    }

    // ========================================================
    // Frequency modulation
    // soft-start 중에는 modulation 적용 안 함.
    // ss_time >= 1.0 s 이후에만 fmod 적용.
    // ========================================================
    if(ss_time < TOTAL_SS_TIME_S)
    {
        fs_cmd = fs_base;
    }
    else
    {
        fs_cmd = ApplyFrequencyModulation(fs_base, run_time);
    }

    // Monitoring variables
    fs_base_mon = fs_base;
    fs_cmd_mon = fs_cmd;
    duty_mon = duty;

    // ADC sensing + LPF + DAC output
    UpdateADCAndDACMonitor(fs_cmd);

    // duty가 너무 작을 때는 불완전 펄스 방지를 위해 off 유지
    if(duty <= 0.001f)
    {
        ForceEPwm1Off();
    }
    else
    {
        UpdateEPwm1(fs_cmd, duty);
        ReleaseEPwm1Trip();
    }

    // ---------------- Time update ----------------
    if(ss_time < TOTAL_SS_TIME_S)
    {
        ss_time += UPDATE_PERIOD_S;

        if(ss_time > TOTAL_SS_TIME_S)
        {
            ss_time = TOTAL_SS_TIME_S;
        }
    }

    // run_time은 modulation 시간축으로 계속 증가
    run_time += UPDATE_PERIOD_S;

    // 장시간 동작 시 float 정밀도 저하 방지
    if(run_time > 1000.0f)
    {
        run_time = TOTAL_SS_TIME_S;
    }

    PieCtrlRegs.PIEACK.all = PIEACK_GROUP1;
}

// ============================================================
// ADC sensing + LPF + DAC monitor update
// ============================================================
void UpdateADCAndDACMonitor(float fs_cmd)
{
    float alpha;
    Uint16 dac_fs_code;
    Uint16 dac_v_code;

    // ---------------- ADC software trigger ----------------
    AdcaRegs.ADCSOCFRC1.all = 0x0001;        // force SOC0

    while(AdcaRegs.ADCINTFLG.bit.ADCINT1 == 0)
    {
        // wait EOC0
    }

    AdcaRegs.ADCINTFLGCLR.bit.ADCINT1 = 1;

    adcRaw = AdcaResultRegs.ADCRESULT0;

    // ADC code -> ADC pin voltage
    V_ADC_RAW = ((float)adcRaw / ADC_MAX_CODE) * ADC_VREF_V;

    // ---------------- 1st-order IIR LPF ----------------
    // Backward-Euler equivalent:
    // alpha = wc*Ts / (1 + wc*Ts)
    alpha = (TWO_PI * ADC_LPF_FC_HZ * UPDATE_PERIOD_S)
          / (1.0f + TWO_PI * ADC_LPF_FC_HZ * UPDATE_PERIOD_S);

    V_ADC_FILT = V_ADC_FILT + alpha * (V_ADC_RAW - V_ADC_FILT);

    // ---------------- DACA: switching frequency monitor ----------------
    // 0 V   = FS_DAC_MIN_HZ
    // 3.3 V = FS_DAC_MAX_HZ
    dac_fs_code = FloatToDacCode(fs_cmd, FS_DAC_MIN_HZ, FS_DAC_MAX_HZ);
    DacaRegs.DACVALS.all = dac_fs_code;

    // ---------------- DACB: filtered ADC voltage monitor ----------------
    // 0 V   = 0 V
    // 3.3 V = 3.3 V
    dac_v_code = FloatToDacCode(V_ADC_FILT, 0.0f, ADC_VREF_V);
    DacbRegs.DACVALS.all = dac_v_code;
}

// ============================================================
// x in [xmin, xmax] -> DAC code 0 ~ 4095
// ============================================================
Uint16 FloatToDacCode(float x, float xmin, float xmax)
{
    float y;

    if(x <= xmin)
    {
        return 0;
    }

    if(x >= xmax)
    {
        return 4095;
    }

    y = (x - xmin) / (xmax - xmin);

    return (Uint16)(y * DAC_MAX_CODE);
}

// ============================================================
// Update EPWM1 frequency and duty
// ============================================================
void UpdateEPwm1(float fs, float duty)
{
    Uint16 tbprd;
    Uint16 cmpa;

    // 변조 포함 보호 범위
    if(fs < 50000.0f)
    {
        fs = 50000.0f;
    }

    if(fs > 250000.0f)
    {
        fs = 250000.0f;
    }

    if(duty < 0.0f)
    {
        duty = 0.0f;
    }

    if(duty > DUTY_MAX)
    {
        duty = DUTY_MAX;
    }

    // Up-down count:
    // fs = TBCLK / (2 * TBPRD)
    tbprd = (Uint16)((float)EPWM_TBCLK_HZ / (2.0f * fs));

    // duty = CMPA / TBPRD
    cmpa = (Uint16)((float)tbprd * duty);

    if(cmpa >= tbprd)
    {
        cmpa = tbprd - 1;
    }

    EALLOW;

    EPwm1Regs.TBPRD = tbprd;
    EPwm1Regs.CMPA.bit.CMPA = cmpa;

    EDIS;
}

// ============================================================
// Force EPWM1A/B off using Trip-Zone
// ============================================================
void ForceEPwm1Off(void)
{
    EALLOW;
    EPwm1Regs.TZFRC.bit.OST = 1;     // One-shot trip force
    EDIS;
}

// ============================================================
// Release Trip-Zone
// ============================================================
void ReleaseEPwm1Trip(void)
{
    EALLOW;
    EPwm1Regs.TZCLR.bit.OST = 1;
    EPwm1Regs.TZCLR.bit.INT = 1;
    EDIS;
}

// ============================================================
// Modulo 1 function
// x -> 0 <= x < 1
// ============================================================
float Mod1(float x)
{
    while(x >= 1.0f)
    {
        x -= 1.0f;
    }

    while(x < 0.0f)
    {
        x += 1.0f;
    }

    return x;
}

// ============================================================
// Normalized triangular wave
//
// input  : phase, cycle unit
// output : -1 ~ +1
//
// phase = 0.00 ->  0
// phase = 0.25 -> +1
// phase = 0.50 ->  0
// phase = 0.75 -> -1
// phase = 1.00 ->  0
// ============================================================
float TriangleWaveNorm(float phase)
{
    float p;
    float y;

    p = Mod1(phase);

    if(p < 0.25f)
    {
        y = 4.0f * p;
    }
    else if(p < 0.75f)
    {
        y = 2.0f - 4.0f * p;
    }
    else
    {
        y = -4.0f + 4.0f * p;
    }

    return y;
}

// ============================================================
// Apply frequency modulation
// ============================================================
float ApplyFrequencyModulation(float fs_base, float time_s)
{
    Uint16 mode;
    Uint16 seq_index;
    float fm;
    float phase_offset;
    float phase;
    float tri;
    float fs_out;

    mode = fmod;

    // --------------------------------------------------------
    // fmod = 5:
    // 400 Hz 주기, 즉 2.5 ms마다
    // mode 1 -> 2 -> 3 -> 4 순서로 변경
    // --------------------------------------------------------
    if(mode == 5)
    {
        seq_index = (Uint16)(time_s / FMOD_SEQUENCE_PERIOD_S);
        seq_index = seq_index % 4;

        mode = seq_index + 1;
    }

    // --------------------------------------------------------
    // mode별 변조 주파수 및 위상 설정
    // --------------------------------------------------------
    if(mode == 0)
    {
        return fs_base;
    }
    else if(mode == 1)
    {
        fm = FMOD_400_HZ;
        phase_offset = PHASE_90_CYCLE;
    }
    else if(mode == 2)
    {
        fm = FMOD_400_HZ;
        phase_offset = PHASE_270_CYCLE;
    }
    else if(mode == 3)
    {
        fm = FMOD_800_HZ;
        phase_offset = PHASE_90_CYCLE;
    }
    else if(mode == 4)
    {
        fm = FMOD_800_HZ;
        phase_offset = PHASE_270_CYCLE;
    }
    else
    {
        // 정의되지 않은 값이면 변조 없음
        return fs_base;
    }

    // --------------------------------------------------------
    // Triangular modulation
    // --------------------------------------------------------
    phase = fm * time_s + phase_offset;
    tri = TriangleWaveNorm(phase);

    fs_out = fs_base + FMOD_DEV_HZ * tri;

    return fs_out;
}
